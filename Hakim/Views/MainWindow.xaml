<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Hakim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Hakim"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="mainPanel"
          FlowDirection="LeftToRight"
          x:FieldModifier="public">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TitleBar Title="Hakim"
                  IsBackButtonVisible="True"
                  IsPaneToggleButtonVisible="True"
                  Subtitle="Preview"
                  Height="48">
            <TitleBar.LeftContent>
                <ImageIcon Source="/Assets/Logo.png" Width="20" Margin="12,0,0,0"/>
            </TitleBar.LeftContent>
            <TitleBar.CenterContent>
                <AutoSuggestBox x:Name="searchAutoSuggestBox"
                                PlaceholderText="Search"
                                QueryIcon="Find"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Width="288" />
            </TitleBar.CenterContent>
            <TitleBar.RightContent>
                <PersonPicture Height="28"
                               Width="28">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{Binding User.profitionalName, Mode=TwoWay}" />
                    </ToolTipService.ToolTip>
                </PersonPicture>
            </TitleBar.RightContent>
        </TitleBar>

        <NavigationView Grid.Row="1"
                        x:Name="navigationView"
                        Width="auto"
                        SelectionChanged="navigationView_SelectionChanged"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneTitle="{Binding User.profitionalName, Mode=TwoWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="homeNavigationItem"
                                    Tag="Home">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="/Assets/Icons/Home.png" />
                        <TextBlock x:Name="homeNavigationItemText"
                                   Margin="12 0" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Name="patientsNavigationItem"
                                    Tag="Patients">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="/Assets/Icons/Clients.png" />
                        <TextBlock x:Name="patientsNavigationItemText"
                                   Margin="12 0" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Name="scheduleNavigationItem"
                                    Tag="Schedule">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="/Assets/Icons/Schedule.png" />
                        <TextBlock x:Name="scheduleNavigationItemText"
                                   Margin="12 0" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Name="statisticsNavigationItem"
                                    Tag="Statistics">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="/Assets/Icons/Statistics.png" />
                        <TextBlock x:Name="statisticsNavigationItemText"
                                   Text="Statistics"
                                   Margin="12 0" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="settingsNavigationItem"
                                    Tag="Settings">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="/Assets/Icons/Settings.png" />
                        <TextBlock x:Name="settingsNavigationItemText"
                                   Margin="12 0" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame Margin="0,0,0,0"
                   x:Name="contentFrame"
                   x:FieldModifier="public" />
        </NavigationView>
    </Grid>
</Window>
