<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Hakim.Views.Patients.Patient.PatientRecordsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Hakim.Controls"
             xmlns:local="using:Hakim.Views.Patients.Patient"
             xmlns:converters="using:Hakim.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:DateShortTimeConverter x:Key="DateShortTimeConverter" />
        <converters:IconUrlConverter x:Key="IconUrlConverter" />
        <converters:UrlNotEmptyConverter x:Key="UrlNotEmptyConverter" />
        <converters:AppointmentIconUrlConverter x:Key="AppointmentIconUrlConverter" />
        <converters:OutputStringConverter x:Key="OutputStringConverter" />
        <converters:FileTypeConverter x:Key="FileTypeConverter" />
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
        <converters:TimeSpanConverter x:Key="TimeSpanConverter" />
    </UserControl.Resources>

    <Pivot>
        <PivotItem Margin="0">
            <PivotItem.Header>
                <PivotHeaderItem x:Name="FilesHeader"  
                                 Tapped="FilesHeader_Tapped">  
                   <StackPanel Orientation="Horizontal">  
                       <Image x:Name="docsImageD"  
                              Height="20"  
                              Source="/Assets/Icons/DocumentsDisabled.png"  
                              Visibility="Collapsed" />  
                       <Image x:Name="docsImage"  
                              Height="20"  
                              Source="/Assets/Icons/Documents.png" />  
                       <TextBlock x:Name="FilesHeaderTextBlock"  
                                  Margin="8 0 0 0"  
                                  Style="{StaticResource SelectedTextBlockStyle}">Fichiers</TextBlock>  
                   </StackPanel>  
                </PivotHeaderItem>
            </PivotItem.Header>
            <StackPanel>
                <Grid x:Name="noFilesTextBlock">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Image Margin="0 24 0 0"
                           Source="/Assets/Icons/DocumentsDisabled.png"
                           Width="64"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.5" />
                    <Image Margin="0 24 0 0"
                           Source="/Assets/Icons/QuestionMark.png"
                           Width="48"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Margin="0 0 0 24"
                               Text="Il n'y a pas de Fichiers médicaux"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="filesGrid"
                      Margin="0 16 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Margin="4 0 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Titre du fichier"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Margin="48 0 0 0" />
                            <TextBlock Margin="0 0 16 0"
                                       Grid.Column="1"
                                       Text="Type et date de création"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Grid>
                    </Grid>
                    <ListView x:Name="PatientFiles"
                              x:FieldModifier="public"
                              Grid.Row="1"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch"
                              Margin="0 0 0 24"
                              SelectionChanged="PatientFiles_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:FileItemControl />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </StackPanel>
        </PivotItem>
        <PivotItem Margin="0">
            <PivotItem.Header>
                <PivotHeaderItem x:Name="AppointmentsHeader"
                                 Tapped="AppointmentsHeader_Tapped">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="appointmentsImageD"
                               Height="20"
                               Source="/Assets/Icons/AppointmentDisabled.png" />
                        <Image x:Name="appointmentsImage"
                               Height="20"
                               Source="/Assets/Icons/Appointment.png"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="AppointmentsHeaderTextBlock"
                                   Margin="8 0 0 0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}">Rendez-vous</TextBlock>
                    </StackPanel>
                </PivotHeaderItem>
            </PivotItem.Header>
            <StackPanel>
                <Grid x:Name="noAppointmentsTextBlock">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Image Margin="0 24 0 0"
                           Source="/Assets/Icons/AppointmentDisabled.png"
                           Width="64"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.5" />
                    <Image Margin="0 24 0 0"
                           Source="/Assets/Icons/QuestionMark.png"
                           Width="48"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Margin="0 0 0 24"
                               Text="Il n'y a pas de Rendez-vous"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="appointmentsGrid"
                      Margin="0 16 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Margin="0 0 0 4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Objectif du rendez-vous"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Margin="52 0 0 0" />
                            <TextBlock Grid.Column="1"
                                       Text="Date et heur"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Grid>
                    </Grid>
                    <ListView x:Name="PatientAppointments"
                              x:FieldModifier="public"
                              Grid.Row="1"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch"
                              Margin="0 0 0 24">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:AppointmentItemControl />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </StackPanel>
        </PivotItem>
        <PivotItem Margin="0">
            <PivotItem.Header>
                <PivotHeaderItem x:Name="FeesHeader"
                                 Tapped="FeesHeader_Tapped">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="feesImageD"
                               Height="20"
                               Source="/Assets/Icons/FeesDisabled.png" />
                        <Image x:Name="feesImage"
                               Height="20"
                               Source="/Assets/Icons/Fees.png"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="FeesTextBlock"
                                   Margin="8 0 0 0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}">Honoraires</TextBlock>
                    </StackPanel>
                </PivotHeaderItem>
            </PivotItem.Header>
        </PivotItem>
    </Pivot>
</UserControl>
